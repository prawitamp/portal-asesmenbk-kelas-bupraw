# ==========================================
# SERVER-SIDE ENVIRONMENT VARIABLES
# (Set these in Netlify Environment Variables / Supabase Secrets)
# DO NOT EXPOSE TO FRONTEND VITE_* VARIABLES
# ==========================================

# Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Required for server-side private queries and signing URLs)
# WARNING: Keep this confidential! Never commit or expose to client JavaScript.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Secret used to sign short-lived session tokens (32+ chars random string)
SESSION_JWT_SECRET=your-random-session-secret-here-min-32-chars

# Storage Bucket Name (Default: assessment-results)
STORAGE_BUCKET=assessment-results

# Default School Year
SCHOOL_YEAR=2026/2027
